<launch>
	<arg name="route"       default="0"/>
	<arg name="mode"       default="MODE_NOT_SPECIFIED"/> <!-- real sim bag -->
	<arg name="bag_mode"       default="MODE_NOT_SPECIFIED"/> <!-- real sim bag -->

	<!--  ***************** bringup the real robot ***************** -->
	<include file="$(find turtlebot3_bringup)/launch/turtlebot3_robot.launch"/>


	<!--  **************** Load the general script ****************  -->
	<include file="$(find eee3043)/launch/challenge1_general.launch"> 
		<arg name="route" value="$(arg route)" />
		<arg name="mode" value="$(arg mode)" />
	</include>
	
	<!--  **************** Map ****************  -->
	<node name="map_server" pkg="map_server" type="map_server" args="$(find eee3043)/maps/challenge1map_real.yaml"/>

</launch>
